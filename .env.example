# PetNFT — environment variables
# Copy this file to backend/.env and frontend/.env (see README) and adjust
# as needed. Never commit real secrets or private keys.

# ---- Backend (backend/.env) ----------------------------------------------

# SQLite by default for zero-setup local dev. For Postgres, change the
# provider in backend/prisma/schema.prisma to "postgresql" first, then set:
# DATABASE_URL=postgresql://user:password@localhost:5432/petnft
DATABASE_URL="file:./dev.db"

PORT=4000

# Sign In With Solana (backend/src/services/authService.ts).
# Frontend origins allowed to request a sign-in message, comma-separated —
# the signed message names this domain, so add your deployed URL here.
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_SESSION_TTL_HOURS=168
# Shown as "Chain ID" in the message Phantom asks to sign.
SOLANA_CLUSTER=devnet

# ---- Solana (used by backend metadata service & frontend) ----------------

SOLANA_RPC_URL=https://api.devnet.solana.com
# Program ids deployed on devnet (see docs/course/weeks 4-5). Used to label
# and decode them in `npm run tx:detect`; clients/pet-passport.ts also reads
# PET_PASSPORT_PROGRAM_ID (pet-counter takes its id from the Anchor IDL).
PROGRAM_ID=nDWNF4Za1PgtFxUBfvfuXf3A6AKrGyq6vu7jwWTRzfJ
PET_PASSPORT_PROGRAM_ID=2k6jZXKSG5tHuksuMiiuvPYxK4av3WyTQMMidzmmNB2U
PET_COUNTER_PROGRAM_ID=F2msfiA9Ndo2s8gMRwykGSaEFbXVLtFHDhGMFRzPEZ8P
PLAYER_PROFILE_PROGRAM_ID=CP6Fmq98dsLrpev7EjEVvuGQ1z2aG9H7vAuDiRPDnYkB

# Base URL where NFT metadata JSON is served from (this MVP serves it
# straight from the backend at /api/metadata/:petId — see README).
METADATA_STORAGE_URL=http://localhost:4000

# Public devnet address that mint payments (SOL) are sent to. This is a
# PUBLIC KEY ONLY — the backend never needs and never holds its private
# key, since it only ever verifies incoming payments, never spends from
# this account. Swap in your own devnet wallet address to actually
# collect mint payments locally, or generate one with `solana-keygen new`.
TREASURY_WALLET=ADB7iuwTCEakyoQ4KPXgWj44nMfCFTeqLkj2TTNJwc7b

# ---- Frontend (frontend/.env) ---------------------------------------------

VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_METADATA_STORAGE_URL=http://localhost:4000
# On-chain profile (programs/player_profile) shown on the Profile page.
VITE_PLAYER_PROFILE_PROGRAM_ID=CP6Fmq98dsLrpev7EjEVvuGQ1z2aG9H7vAuDiRPDnYkB
